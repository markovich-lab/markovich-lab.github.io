const years = [...new Set(publications.map((p) => p.year))];

// Split an author string so lab authors can be bolded
const splitAuthors = (authors: string) =>
	authors.split(", ").map((name) => ({ name, isLab: labAuthors.includes(name) }));
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">
		Our research is centered on the broad theme of science supporting sustainable groundwater
		management.
	</h1>

	<p class="text-muted mb-8">
		Groundwater systems are chronically under-observed, so we often manage them under deep
		uncertainty about aquifer properties, their connection to surface water and ecosystems, and how
		they're responding to drought, climate change, and human use. Our work lives in the two-way
		conversation between observation and modeling: new and underused data sources help constrain our
		models, while those models in turn tell us which observations would actually move the needle. To
		this end, we combine numerical modeling with field observation and geophysical and remote
		sensing techniques that probe basic hydrologic science questions and produce decision-relevant,
		actionable science.
	</p>

	<div class="mx-auto max-w-4xl px-4">
		<ul class="flex flex-col gap-6" role="list">
			{
				projects.map((p) => (
					<li class="bg-card flex flex-col items-start gap-6 rounded-lg p-6 shadow-sm sm:flex-row">
						<div class="flex flex-shrink-0 gap-2">
							{p.images.map((img) => (
								<img src={img.src} alt={img.alt} class="h-36 w-36 rounded-md object-cover" />
							))}
						</div>

						<div class="min-w-0 flex-1">
							<h3 class="text-xl leading-tight font-semibold">{p.title}</h3>
							<p class="text-muted mt-3 text-sm">{p.blurb}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
	<section class="mx-auto mt-16 max-w-4xl px-4" id="publications">
		<h2 class="title mb-4">Publications</h2>
		<p class="text-muted mb-8">
			Peer-reviewed articles. For a complete list including conference abstracts, see
			<a class="cactus-link" href={scholarUrl} rel="noreferrer" target="_blank">Google Scholar</a>.
		</p>

		{
			years.map((year) => (
				<section class="mb-10">
					<h3 class="text-accent mb-4 text-lg font-semibold">{year}</h3>
					<ul class="flex flex-col gap-5" role="list">
						{publications
							.filter((p) => p.year === year)
							.map((p) => (
								<li>
									<p class="font-semibold">
										<a
											class="hover:text-accent"
											href={`https://doi.org/${p.doi}`}
											rel="noreferrer"
											target="_blank"
										>
											{p.title}
										</a>
									</p>
									<p class="text-muted mt-1 text-sm">
										{splitAuthors(p.authors).map((a, i) => (
											<>
												{i > 0 && ", "}
												{a.isLab ? <strong class="text-global-text">{a.name}</strong> : a.name}
											</>
										))}
									</p>
									<p class="text-muted text-sm italic">{p.venue}</p>
								</li>
							))}
					</ul>
				</section>
			))
		}
	</section>
</PageLayout>
