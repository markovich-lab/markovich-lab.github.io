---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Independent groundwater modeling consulting through Baseflow Environmental",
	title: "Consulting",
};

const applications = [
	"Water supply & allocation optimization",
	"Managed aquifer recharge & aquifer storage and recovery",
	"Mine dewatering & closure",
	"Fate & transport and remedial design & optimization",
	"Geothermal applications",
];

const contactEmail = "kmarkovich@baseflowenv.com";
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">Consulting</h1>
	<div class="prose prose-sm prose-cactus mb-8 max-w-none">
		<p>
			Dr. Markovich provides independent consulting through <strong>Baseflow Environmental</strong>,
			offering numerical decision-support modeling and model review for:
		</p>
		<p class="text-sm italic">
			Baseflow Environmental is an independent business and is not affiliated with the University
			of New Mexico.
		</p>
	</div>

	<ul class="grid gap-3 sm:grid-cols-2" role="list">
		{
			applications.map((app) => (
				<li class="bg-card border-accent rounded-lg border-l-4 px-5 py-4 font-semibold shadow-sm">
					{app}
				</li>
			))
		}
	</ul>

	<div class="mt-8">
		<a
			class="bg-accent inline-flex items-center rounded px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90"
			href={`mailto:${contactEmail}`}
		>
			Get in touch
		</a>
		<p class="text-muted mt-2 text-sm">{contactEmail}</p>
	</div>
</PageLayout>
